# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Secrets — EXAMPLE TEMPLATE
# Copy this file to .streamlit/secrets.toml and fill in your real values.
# NEVER commit secrets.toml — it is in .gitignore.
# On Streamlit Community Cloud, paste these values in:
#   App Settings → Secrets
# ─────────────────────────────────────────────────────────────────────────────

# If you deploy the FastAPI backend separately (e.g. on Render / Railway),
# set the public URL here. Leave blank or omit to run in offline/demo mode.
API_BASE_URL = ""

# OpenRouter LLM key (optional — only needed for GenAI Assistant)
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "meta-llama/llama-3.1-8b-instruct:free"
LLM_PROVIDER = "openrouter"

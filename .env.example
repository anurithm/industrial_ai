# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values for local development
# On Render: set these in the Environment section of your service dashboard
# On Streamlit Cloud: set API_BASE_URL in App Settings → Secrets
# NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# PORT is injected automatically by Render — do not set this locally
# PORT=10000

# CORS: comma-separated list of allowed origins.
# Use * for local dev. Set to your Streamlit app URL in production.
# Example: CORS_ORIGINS=https://industrial-ai.streamlit.app
CORS_ORIGINS=*

# ── Dashboard ────────────────────────────────────────────────────────────────
# URL the Streamlit dashboard uses to reach the API.
# Locally: http://localhost:8000
# After Render deploy: https://<your-service>.onrender.com
API_BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/predictions.db

# ── LLM / GenAI (optional — needed for GenAI Assistant page) ─────────────────
# Option A: OpenRouter (free tier available at https://openrouter.ai)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Option B: Ollama (local only)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Model versioning ──────────────────────────────────────────────────────────
MODEL_VERSION=1.0.0
RANDOM_SEED=42

# Environment
.env
.env.local
.env.*.local

# Streamlit secrets — NEVER commit real secrets
.streamlit/secrets.toml

# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/

# Data (keep raw/ and processed/ dirs, exclude large files)
data/raw/*.csv
data/raw/*.zip
data/*.db
*.db

# Models — .joblib files are committed (all < 5 MB, needed for cloud deployment)
# Only exclude very large raw pickle dumps if you create them
# models/*.pkl
# models/*.joblib

# ChromaDB — pre-built vector store committed to Git (needed for cloud deployment)
# Do NOT add chroma_db/ to .gitignore — Render uses this to avoid building at startup
# chroma_db/

# Reports (keep structure, exclude generated reports from git if large)
# reports/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
__MACOSX/

# Node (if any frontend tooling)
node_modules/

# Secrets and keys
*.pem
*.key
*.p12
